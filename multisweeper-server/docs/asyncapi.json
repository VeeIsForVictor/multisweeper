{
  "asyncapi": "3.0.0",
  "channels": {
    "multisweeper": {
      "address": "/",
      "messages": {
        "CommandRejected": {
          "$ref": "#/components/messages/CommandRejected"
        },
        "ConnectionPing": {
          "$ref": "#/components/messages/ConnectionPing"
        },
        "ConnectionPong": {
          "$ref": "#/components/messages/ConnectionPong"
        },
        "ConnectionReady": {
          "$ref": "#/components/messages/ConnectionReady"
        },
        "GameAction": {
          "$ref": "#/components/messages/GameAction"
        },
        "GameStart": {
          "$ref": "#/components/messages/GameStart"
        },
        "GameStarted": {
          "$ref": "#/components/messages/GameStarted"
        },
        "RoomCreate": {
          "$ref": "#/components/messages/RoomCreate"
        },
        "RoomJoin": {
          "$ref": "#/components/messages/RoomJoin"
        },
        "RoomLeave": {
          "$ref": "#/components/messages/RoomLeave"
        },
        "RoomRemoved": {
          "$ref": "#/components/messages/RoomRemoved"
        },
        "RoomState": {
          "$ref": "#/components/messages/RoomState"
        },
        "RoomStateGet": {
          "$ref": "#/components/messages/RoomStateGet"
        },
        "RoomsList": {
          "$ref": "#/components/messages/RoomsList"
        },
        "RoomsListed": {
          "$ref": "#/components/messages/RoomsListed"
        }
      }
    }
  },
  "components": {
    "messages": {
      "CommandRejected": {
        "contentType": "application/json",
        "correlationId": {
          "description": "The message_id of the client command that caused this server message, when applicable.",
          "location": "$message.payload#/correlation_id"
        },
        "name": "CommandRejected",
        "payload": {
          "properties": {
            "correlation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "$ref": "#/components/schemas/ClientError"
            },
            "message_id": {
              "type": "string"
            },
            "type": {
              "const": "command.rejected",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id",
            "error"
          ],
          "type": "object"
        },
        "title": "CommandRejected"
      },
      "ConnectionPing": {
        "contentType": "application/json",
        "name": "ConnectionPing",
        "payload": {
          "properties": {
            "message_id": {
              "type": "string"
            },
            "type": {
              "const": "connection.ping",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id"
          ],
          "type": "object"
        },
        "title": "ConnectionPing"
      },
      "ConnectionPong": {
        "contentType": "application/json",
        "correlationId": {
          "description": "The message_id of the client command that caused this server message, when applicable.",
          "location": "$message.payload#/correlation_id"
        },
        "name": "ConnectionPong",
        "payload": {
          "properties": {
            "correlation_id": {
              "type": "string"
            },
            "message_id": {
              "type": "string"
            },
            "type": {
              "const": "connection.pong",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id",
            "correlation_id"
          ],
          "type": "object"
        },
        "title": "ConnectionPong"
      },
      "ConnectionReady": {
        "contentType": "application/json",
        "name": "ConnectionReady",
        "payload": {
          "properties": {
            "message_id": {
              "type": "string"
            },
            "player_id": {
              "type": "string"
            },
            "type": {
              "const": "connection.ready",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id",
            "player_id"
          ],
          "type": "object"
        },
        "title": "ConnectionReady"
      },
      "GameAction": {
        "contentType": "application/json",
        "name": "GameAction",
        "payload": {
          "properties": {
            "action": {
              "$ref": "#/components/schemas/ClientGameAction"
            },
            "message_id": {
              "type": "string"
            },
            "type": {
              "const": "game.action",
              "type": "string"
            },
            "x": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "message_id",
            "action",
            "x",
            "y"
          ],
          "type": "object"
        },
        "title": "GameAction"
      },
      "GameStart": {
        "contentType": "application/json",
        "name": "GameStart",
        "payload": {
          "properties": {
            "difficulty": {
              "$ref": "#/components/schemas/ClientDifficulty"
            },
            "message_id": {
              "type": "string"
            },
            "type": {
              "const": "game.start",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id",
            "difficulty"
          ],
          "type": "object"
        },
        "title": "GameStart"
      },
      "GameStarted": {
        "contentType": "application/json",
        "correlationId": {
          "description": "The message_id of the client command that caused this server message, when applicable.",
          "location": "$message.payload#/correlation_id"
        },
        "name": "GameStarted",
        "payload": {
          "properties": {
            "correlation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "message_id": {
              "type": "string"
            },
            "type": {
              "const": "game.started",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id"
          ],
          "type": "object"
        },
        "title": "GameStarted"
      },
      "RoomCreate": {
        "contentType": "application/json",
        "name": "RoomCreate",
        "payload": {
          "properties": {
            "message_id": {
              "type": "string"
            },
            "type": {
              "const": "room.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id"
          ],
          "type": "object"
        },
        "title": "RoomCreate"
      },
      "RoomJoin": {
        "contentType": "application/json",
        "name": "RoomJoin",
        "payload": {
          "properties": {
            "message_id": {
              "type": "string"
            },
            "room_code": {
              "type": "string"
            },
            "type": {
              "const": "room.join",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id",
            "room_code"
          ],
          "type": "object"
        },
        "title": "RoomJoin"
      },
      "RoomLeave": {
        "contentType": "application/json",
        "name": "RoomLeave",
        "payload": {
          "properties": {
            "message_id": {
              "type": "string"
            },
            "type": {
              "const": "room.leave",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id"
          ],
          "type": "object"
        },
        "title": "RoomLeave"
      },
      "RoomRemoved": {
        "contentType": "application/json",
        "correlationId": {
          "description": "The message_id of the client command that caused this server message, when applicable.",
          "location": "$message.payload#/correlation_id"
        },
        "name": "RoomRemoved",
        "payload": {
          "properties": {
            "correlation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "message_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "type": {
              "const": "room.removed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id",
            "reason"
          ],
          "type": "object"
        },
        "title": "RoomRemoved"
      },
      "RoomState": {
        "contentType": "application/json",
        "correlationId": {
          "description": "The message_id of the client command that caused this server message, when applicable.",
          "location": "$message.payload#/correlation_id"
        },
        "name": "RoomState",
        "payload": {
          "properties": {
            "code": {
              "type": "string"
            },
            "correlation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "game": {
              "$ref": "#/components/schemas/MatchView"
            },
            "message_id": {
              "type": "string"
            },
            "owner": {
              "type": [
                "string",
                "null"
              ]
            },
            "players": {
              "items": {
                "$ref": "#/components/schemas/PlayerView"
              },
              "type": "array"
            },
            "type": {
              "const": "room.state",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id",
            "code",
            "players",
            "game"
          ],
          "type": "object"
        },
        "title": "RoomState"
      },
      "RoomStateGet": {
        "contentType": "application/json",
        "name": "RoomStateGet",
        "payload": {
          "properties": {
            "message_id": {
              "type": "string"
            },
            "type": {
              "const": "room.state.get",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id"
          ],
          "type": "object"
        },
        "title": "RoomStateGet"
      },
      "RoomsList": {
        "contentType": "application/json",
        "name": "RoomsList",
        "payload": {
          "properties": {
            "message_id": {
              "type": "string"
            },
            "type": {
              "const": "rooms.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id"
          ],
          "type": "object"
        },
        "title": "RoomsList"
      },
      "RoomsListed": {
        "contentType": "application/json",
        "correlationId": {
          "description": "The message_id of the client command that caused this server message, when applicable.",
          "location": "$message.payload#/correlation_id"
        },
        "name": "RoomsListed",
        "payload": {
          "properties": {
            "correlation_id": {
              "type": "string"
            },
            "message_id": {
              "type": "string"
            },
            "rooms": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "rooms.listed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message_id",
            "correlation_id",
            "rooms"
          ],
          "type": "object"
        },
        "title": "RoomsListed"
      }
    },
    "schemas": {
      "CellView": {
        "oneOf": [
          {
            "enum": [
              "HiddenCell",
              "FlaggedCell",
              "MinedCell"
            ],
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "VisibleCell": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "VisibleCell"
            ],
            "type": "object"
          }
        ]
      },
      "ClientDifficulty": {
        "enum": [
          "Test",
          "Easy",
          "Medium",
          "Hard"
        ],
        "type": "string"
      },
      "ClientError": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ClientGameAction": {
        "enum": [
          "reveal",
          "flag"
        ],
        "type": "string"
      },
      "ErrorCode": {
        "enum": [
          "room_already_joined",
          "no_room_joined",
          "room_dropped",
          "room_not_found",
          "not_room_owner",
          "game_already_started",
          "game_not_started",
          "game_ended",
          "player_is_spectating",
          "player_eliminated",
          "not_current_player",
          "no_players_remaining",
          "player_not_found",
          "game_error",
          "room_unavailable",
          "invalid_message",
          "duplicate_message_id"
        ],
        "type": "string"
      },
      "GameActionResult": {
        "enum": [
          "Applied",
          "Stalled",
          "Started",
          "Eliminated",
          "Won"
        ],
        "type": "string"
      },
      "GameSnapshot": {
        "properties": {
          "action_result": {
            "$ref": "#/components/schemas/GameActionResult"
          },
          "board": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/CellView"
              },
              "type": "array"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/GameStatus"
          }
        },
        "required": [
          "status",
          "action_result",
          "board"
        ],
        "type": "object"
      },
      "GameStatus": {
        "enum": [
          "Won",
          "NoWinner",
          "Playing"
        ],
        "type": "string"
      },
      "MatchState": {
        "oneOf": [
          {
            "enum": [
              "Waiting",
              "Won",
              "NoWinner"
            ],
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "Playing": {
                "properties": {
                  "current_player": {
                    "type": "string"
                  },
                  "last_player": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "current_player"
                ],
                "type": "object"
              }
            },
            "required": [
              "Playing"
            ],
            "type": "object"
          }
        ]
      },
      "MatchView": {
        "properties": {
          "game": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GameSnapshot"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "$ref": "#/components/schemas/MatchState"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "PlayerState": {
        "enum": [
          "Spectator",
          "Playing",
          "Eliminated"
        ],
        "type": "string"
      },
      "PlayerView": {
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/PlayerState"
          }
        },
        "required": [
          "id",
          "state"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Real-time room and Minesweeper messages exchanged over WebSocket.",
    "title": "Multisweeper WebSocket API",
    "version": "0.1.0"
  },
  "operations": {
    "clientMessages": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/multisweeper"
      },
      "messages": [
        {
          "$ref": "#/channels/multisweeper/messages/ConnectionPing"
        },
        {
          "$ref": "#/channels/multisweeper/messages/RoomsList"
        },
        {
          "$ref": "#/channels/multisweeper/messages/RoomJoin"
        },
        {
          "$ref": "#/channels/multisweeper/messages/RoomCreate"
        },
        {
          "$ref": "#/channels/multisweeper/messages/RoomLeave"
        },
        {
          "$ref": "#/channels/multisweeper/messages/GameStart"
        },
        {
          "$ref": "#/channels/multisweeper/messages/GameAction"
        },
        {
          "$ref": "#/channels/multisweeper/messages/RoomStateGet"
        }
      ]
    },
    "serverMessages": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/multisweeper"
      },
      "messages": [
        {
          "$ref": "#/channels/multisweeper/messages/ConnectionReady"
        },
        {
          "$ref": "#/channels/multisweeper/messages/ConnectionPong"
        },
        {
          "$ref": "#/channels/multisweeper/messages/RoomsListed"
        },
        {
          "$ref": "#/channels/multisweeper/messages/RoomState"
        },
        {
          "$ref": "#/channels/multisweeper/messages/RoomRemoved"
        },
        {
          "$ref": "#/channels/multisweeper/messages/CommandRejected"
        },
        {
          "$ref": "#/channels/multisweeper/messages/GameStarted"
        }
      ]
    }
  },
  "servers": {
    "local": {
      "description": "Local Multisweeper server",
      "host": "localhost:8080",
      "protocol": "ws"
    }
  }
}
